  METHOD /scmtms/if_se_tpevtntf~inbound_processing.
*&------------------------------------------------------------------------------*
*&    Date           User               Name                   Version
*& ----------      --------        ----------------           --------
*& 27.Aug.2026     PGAURAV         Gaurav Prajapati             001
*&
*& 001: To Integrate and Trigger Execution Event for NOSTA using Proxy
*&-------------------------------------------------------------------------------*
    TYPES: BEGIN OF ty_event,
             tor_event TYPE	/scmtms/tor_event,
           END OF ty_event.

    DATA: lt_event   TYPE TABLE OF ty_event,
          lt_tor_sel TYPE TABLE OF /bobf/s_frw_query_selparam.

    DATA: lt_d_root TYPE /scmtms/t_tor_root_k,
          lt_d_stop TYPE /scmtms/t_tor_stop_k.

    DATA(lo_srvmgr_tor) = /bobf/cl_tra_serv_mgr_factory=>get_service_manager( /scmtms/if_tor_c=>sc_bo_key ).
    DATA(lv_tor_id)     = in-transportation_event-object_reference-transportation_order_id-content.

    CHECK lv_tor_id IS NOT INITIAL.

    lv_tor_id = |{ lv_tor_id ALPHA = IN }|.

    INSERT VALUE #( attribute_name  = /scmtms/if_tor_c=>sc_node_attribute-root-tor_id
                    sign            = /bobf/if_atf_const=>sc_sign_including
                    option          = /bobf/if_atf_const=>sc_option_equal
                    low             = lv_tor_id ) INTO TABLE lt_tor_sel.

    lo_srvmgr_tor->query( EXPORTING
                             iv_query_key            = /scmtms/if_tor_c=>sc_query-root-root_elements
                             it_selection_parameters = lt_tor_sel
                             iv_fill_data            = abap_true
                          IMPORTING
                             et_data                 = lt_d_root
                             et_key                  = DATA(lt_key) ).

    CALL METHOD lo_srvmgr_tor->retrieve_by_association(
      EXPORTING
        it_key         = lt_key
        iv_node_key    = /scmtms/if_tor_c=>sc_node-root
        iv_association = /scmtms/if_tor_c=>sc_association-root-stop
        iv_fill_data   = abap_true
      IMPORTING
        et_data        = lt_d_stop ).

    LOOP AT out-transportation_event-event ASSIGNING FIELD-SYMBOL(<fs_event>) WHERE event_type_code-content = 'ARRIV_DEST'.
      DATA(lv_tor_event) = <fs_event>-event_type_code-content.
    ENDLOOP.


    IF ( lv_tor_event IS NOT INITIAL ).
      SELECT SINGLE stop_cat
               FROM /scmtms/c_ev_ty
               INTO @DATA(lv_stop_cat)
              WHERE tor_event EQ @lv_tor_event.

      IF lv_stop_cat IS NOT INITIAL.

        READ TABLE lt_d_root INTO DATA(ls_d_root) WITH KEY tor_id COMPONENTS tor_id = lv_tor_id.
        IF sy-subrc EQ 0.
          LOOP AT out-transportation_event-event ASSIGNING <fs_event>.

            "Find STOP ID from location
            READ TABLE lt_d_stop INTO DATA(ls_d_stop) WITH KEY log_locid = <fs_event>-location-internal_id-content stop_cat = lv_stop_cat.
            IF sy-subrc EQ 0.
              <fs_event>-stop-id = ls_d_stop-stop_id.
            ENDIF.

          ENDLOOP.
        ENDIF.
      ENDIF.
    ENDIF.

  ENDMETHOD.
